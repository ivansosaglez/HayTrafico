# Todas las variables son opcionales. La DGT no requiere API key.

# URL del feed DATEX2 de incidencias (por defecto, DATEX2 v3.7 del NAP)
# DGT_API_URL=https://nap.dgt.es/datex2/v3/dgt/SituationPublication/datex2_v37.xml

# Segundos que el servidor reutiliza la respuesta de la DGT (el feed se actualiza cada ~60 s)
# DGT_CACHE_TTL=60

# Segundos entre consultas del navegador a /api/incidents
# NEXT_PUBLIC_POLL_INTERVAL=60

# Plantilla de tiles del mapa y su atribución (HTML)
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# URL pública del sitio (SEO: canonical, sitemap). En Vercel es opcional: si no se define,
# se usa automáticamente el dominio de producción del proyecto (VERCEL_PROJECT_PRODUCTION_URL).
# Defínela solo si usas un dominio propio distinto.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.example
